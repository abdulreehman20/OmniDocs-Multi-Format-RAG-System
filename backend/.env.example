# Application
APP_NAME=backend
ENVIRONMENT=development
DEBUG=false

# Neon Managed Better Auth (JWT issuer)
NEON_AUTH_BASE_URL=
# Optional override; defaults to {NEON_AUTH_BASE_URL}/.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# ENVIRONMENT=test only
JWT_TEST_SECRET=test-jwt-secret-do-not-use-in-prod-32b

# Postgres — Neon database (isolated development branch/project)
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Object Storage (S3-compatible). Private bucket required for uploads.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
S3_BUCKET_DOCUMENTS=documents

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_FILE_SIZE_BYTES=26214400
MAX_FILES_PER_SELECTION=6

# Redis (optional until Phase 4)
REDIS_URL=

# Inngest
INNGEST_APP_ID=rag-basic
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=true

# Pinecone / OpenRouter (later phases)
PINECONE_API_KEY=
OPENROUTER_API_KEY=

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
