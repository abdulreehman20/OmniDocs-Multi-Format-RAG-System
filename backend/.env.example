# Application
APP_NAME=backend
# development | test | staging | production
ENVIRONMENT=development
DEBUG=false

# Propel Auth — temporary until Phase 1 (Neon Managed Better Auth)
PROPELAUTH_AUTH_URL=
PROPELAUTH_API_KEY=

# Postgres — Neon database (use an isolated development branch/project)
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Object Storage (S3-compatible). Create a private bucket per environment.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
S3_BUCKET_DOCUMENTS=documents

# Redis (optional in Phase 0; required later for caching)
REDIS_URL=

# Inngest — use Dev Server locally (npx inngest-cli@latest dev)
INNGEST_APP_ID=rag-basic
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=true

# Pinecone — Vector database (Phase 2+)
PINECONE_API_KEY=

# OpenRouter — chat generation (Phase 3+)
OPENROUTER_API_KEY=

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
