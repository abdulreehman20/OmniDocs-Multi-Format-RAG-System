# Application
APP_NAME=backend
ENVIRONMENT=development
DEBUG=false

# Neon Managed Better Auth (JWT issuer)
NEON_AUTH_BASE_URL=
# Optional override; defaults to {NEON_AUTH_BASE_URL}/.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# ENVIRONMENT=test only
JWT_TEST_SECRET=test-jwt-secret-do-not-use-in-prod-32b

# Postgres — Neon database (isolated development branch/project)
# DATABASE_URL_POOLED optional; defaults to DATABASE_URL when omitted
DATABASE_URL=
DATABASE_URL_POOLED=

# Neon Object Storage (S3-compatible). Private bucket required for uploads.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
S3_BUCKET_DOCUMENTS=documents

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_FILE_SIZE_BYTES=26214400
MAX_FILES_PER_SELECTION=6

# Redis (optional until Phase 4)
REDIS_URL=

# Inngest
INNGEST_APP_ID=rag-basic
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=true

# OpenRouter embeddings (Phase 2) / chat (Phase 3)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL_ID=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Pinecone (dimension must match embedding model)
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=

# Chat / RAG (Phase 3)
CHAT_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
MAX_SELECTED_DOCUMENTS_PER_CHAT=6
MAX_HISTORY_MESSAGES=12
MAX_RETRIEVAL_CANDIDATES=25
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_TOKENS=3000
CHAT_STREAM_TIMEOUT_SECONDS=120

# Ingestion
CHUNKER_VERSION=langchain-recursive-v1
PARSER_VERSION=langchain-loaders-v1
INGESTION_EMBED_BATCH_SIZE=32
INGESTION_MAX_CONCURRENCY_PER_USER=1

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
